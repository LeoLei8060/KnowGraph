# Local paths. Both may be absolute or relative to the current directory.
KNOWGRAPH_HOME=data
KNOWGRAPH_VAULT=vault

# IANA timezone used for collection and weekly/monthly review windows.
KNOWGRAPH_TIMEZONE=Asia/Shanghai

# Default model used when the initial Anthropic provider is first created.
# Later changes are made per provider in Settings > Model services.
KNOWGRAPH_MODEL=claude-opus-5-5

# Set to 0 to force local extractive mode even when credentials are available.
KNOWGRAPH_LLM_ENABLED=1

# Number of new candidates saved per source run.
KNOWGRAPH_COLLECTION_LIMIT=12

# Optional provider keys. You can also save a key per model service in the UI.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# OPENAI_API_KEY=
